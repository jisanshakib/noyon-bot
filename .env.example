# ============================================================
# BNB Telegram Bot — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# --- Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- Supabase / PostgreSQL ---
# Primary connection string (required)
SUPABASE_DB_URL=postgresql://user:password@host:5432/dbname

# Optional Supabase REST API (for future extensions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Admin ---
# Telegram numeric user ID of the administrator
ADMIN_ID=123456789

# --- BSC RPC ---
BSC_RPC_URL=https://bsc-dataseed1.binance.org/

# --- Optional: Bot settings ---
# Set to "true" to enable verbose debug logging
LOG_LEVEL=info

# --- Binance Wallet Pairing (Agentic Wallet) ---
# Base URL for Binance wallet deep-link / WalletConnect pairing.
# Leave blank in test environments — the bot will use a stub guard.
BINANCE_WALLET_PAIRING_BASE_URL=https://app.binance.com/en/wc?uri=
